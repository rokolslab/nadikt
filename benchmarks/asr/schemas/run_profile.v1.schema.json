{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nadikt.local/schemas/asr/run_profile.v1.schema.json",
  "title": "Nadikt ASR benchmark run profile v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "manifest_kind",
    "profile_id",
    "run_kind",
    "ordered_candidate_ids",
    "min_repeats",
    "dataset_id",
    "dataset_revision",
    "warmup_sample_ids",
    "scored_categories",
    "duration_tolerance_seconds",
    "expected_sample_durations",
    "scoring_policy_id",
    "normalization_policy_id",
    "metric_policy_id",
    "percentile_policy_id",
    "thread_policy_id",
    "launcher_profiles"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "manifest_kind": {"const": "benchmark_run_profile"},
    "profile_id": {"type": "string", "minLength": 1},
    "run_kind": {"type": "string", "minLength": 1},
    "ordered_candidate_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "min_repeats": {"type": "integer", "minimum": 1},
    "dataset_id": {"type": "string", "minLength": 1},
    "dataset_revision": {"type": "string", "minLength": 1},
    "warmup_sample_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "scored_categories": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "duration_tolerance_seconds": {"type": "number", "minimum": 0},
    "expected_sample_durations": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "number", "exclusiveMinimum": 0}},
    "scoring_policy_id": {"type": "string", "minLength": 1},
    "normalization_policy_id": {"type": "string", "minLength": 1},
    "metric_policy_id": {"type": "string", "minLength": 1},
    "percentile_policy_id": {"type": "string", "minLength": 1},
    "thread_policy_id": {"type": "string", "minLength": 1},
    "launcher_profiles": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "string", "minLength": 1}}
  }
}
