{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nadikt.local/schemas/model_inventory.v1.schema.json",
  "title": "Nadikt Local Model Inventory v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "manifest_kind", "inventory_id", "packages"],
  "properties": {
    "schema_version": {"const": 1},
    "manifest_kind": {"enum": ["example", "local_inventory"]},
    "inventory_id": {"type": "string", "minLength": 1},
    "packages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["package_id", "package_path", "manifest_relative_path", "manifest_sha256"],
        "properties": {
          "package_id": {"type": "string", "minLength": 1},
          "package_path": {"type": "string", "minLength": 1},
          "manifest_relative_path": {"type": "string", "minLength": 1},
          "manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    }
  }
}
